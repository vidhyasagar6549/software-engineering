Q4).\par
Create a VIEW named TopSpendersView that shows usernames and order_total from a FoodOrder table where order_total is greater than 1000.\par
CREATE VIEW TopSpendersView AS\par
SELECT \par
    SpotifyUser.username,\par
    FoodOrder.order_total\par
FROM FoodOrder\par
JOIN SpotifyUser\par
    ON FoodOrder.user_id = SpotifyUser.user_id\par
WHERE FoodOrder.order_total > 1000;\par
